# Stripe secret key (create one at https://dashboard.stripe.com/apikeys)
# Required for the checkout API. Add this in Vercel: Project → Settings → Environment Variables
STRIPE_SECRET_KEY=sk_test_...

# Comma-separated 2-letter country codes for shipping address collection in checkout
# Example: US,CA
STRIPE_ALLOWED_COUNTRIES=US

# Optional: shipping rate IDs from Stripe Dashboard (Shipping rates)
# If set, customers can select these options in Checkout
STRIPE_SHIPPING_RATE_STANDARD=shr_...
STRIPE_SHIPPING_RATE_EXPRESS=shr_...

# Stripe webhook signing secret (from Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Discord webhook URL for order notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 5-digit code buyers enter at checkout (share only with people allowed to buy)
CHECKOUT_ACCESS_CODE=12345

# Signs checkout verification cookies (use a long random string; do not share)
CHECKOUT_SESSION_SECRET=replace_with_a_long_random_secret_string

# Thank-you + order emails via Resend (https://resend.com) after successful Stripe payment
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=3D Prints for Good <orders@yourdomain.com>
ORDER_NOTIFY_EMAIL=you@example.com
# Optional: used in thank-you email links if Stripe success_url is missing
SITE_URL=https://3dprintsforgood.com
