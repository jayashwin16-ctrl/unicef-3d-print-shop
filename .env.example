# Stripe secret key (create one at https://dashboard.stripe.com/apikeys)
# Required for the checkout API. Add this in Vercel: Project → Settings → Environment Variables
STRIPE_SECRET_KEY=sk_test_...

# Comma-separated 2-letter country codes for shipping address collection in checkout
# Example: US,CA
STRIPE_ALLOWED_COUNTRIES=US

# Optional: shipping rate IDs from Stripe Dashboard (Shipping rates)
# If set, customers can select these options in Checkout
STRIPE_SHIPPING_RATE_STANDARD=shr_...
STRIPE_SHIPPING_RATE_EXPRESS=shr_...

# Stripe webhook signing secret (from Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Discord webhook URL for order notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
